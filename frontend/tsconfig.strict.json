{
  // Tier 2: full strict mode over every file. `strict-ratchet.ts` runs this and
  // fails on any error outside the files it lists as not strict yet.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true
  }
}
